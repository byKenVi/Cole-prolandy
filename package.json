{
  "name": "workspace",
  "version": "0.0.0",
  "license": "MIT",
  "packageManager": "pnpm@10.26.1",
  "scripts": {
    "preinstall": "node ./scripts/ensure-pnpm.cjs",
    "dev": "node --env-file=.env --env-file=artifacts/landys-pro/.env.local ./scripts/local-runner.mjs dev",
    "dev:start": "node --env-file=.env --env-file=artifacts/landys-pro/.env.local ./scripts/local-runner.mjs start",
    "dev:reseed": "node --env-file=.env --env-file=artifacts/landys-pro/.env.local ./scripts/local-runner.mjs reseed",
    "dev:clerk-qa": "node --env-file=.env --env-file=artifacts/landys-pro/.env.local ./scripts/local-runner.mjs clerk-qa",
    "dev:verify": "node --env-file=.env --env-file=artifacts/landys-pro/.env.local ./scripts/local-runner.mjs verify",
    "dev:storage": "node --env-file=.env --env-file=artifacts/landys-pro/.env.local ./scripts/local-runner.mjs storage",
    "dev:stripe-smoke": "node --env-file=.env --env-file=artifacts/landys-pro/.env.local ./scripts/local-runner.mjs stripe",
    "dev:wix-intake": "node --env-file=.env --env-file=artifacts/landys-pro/.env.local ./scripts/local-runner.mjs wix",
    "build": "pnpm run typecheck && pnpm -r --if-present run build",
    "typecheck:libs": "tsc --build",
    "typecheck": "pnpm run typecheck:libs && pnpm -r --filter \"./artifacts/**\" --filter \"./scripts\" --if-present run typecheck"
  },
  "private": true,
  "dependencies": {
    "@replit/connectors-sdk": "^0.4.1",
    "stripe-replit-sync": "^1.0.0"
  },
  "devDependencies": {
    "prettier": "^3.9.5",
    "typescript": "~5.9.3"
  }
}
