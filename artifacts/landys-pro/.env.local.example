# Landy's Pro — local Cursor QA environment (TEMPLATE)
# Copy to `.env.local` (gitignored) OR `.env` for Next.js.
# NEVER commit real secrets. NEVER point these URLs at production.

# ── Core ─────────────────────────────────────────────────────
LANDYS_ENV="local"
LOCAL_SUPABASE_PROJECT_REF="your-dedicated-dev-project-ref"
NEXT_PUBLIC_APP_URL="http://localhost:3000"
AUTH_MODE="dev"
# For Clerk local testing instead of cookie auth:
# AUTH_MODE="clerk"
# NEXT_PUBLIC_CLERK_PUBLISHABLE_KEY="pk_test_..."
# CLERK_SECRET_KEY="sk_test_..."
ADMIN_EMAILS="admin.qa+clerk_test@example.com"
LOCAL_ADMIN_EMAIL="admin.qa+clerk_test@example.com"
LOCAL_CONTRACTOR_EMAILS="contractor.qa+clerk_test@example.com,contractor2@localhost.test,contractor3@localhost.test,contractor4@localhost.test"
# Clerk development test emails use the documented +clerk_test pattern, so
# second-touchpoint email verification is deterministic during browser QA.

# Database and integration secrets live in the repository-root .env.
# Root commands load this file for local-only settings, then root .env for the
# dedicated Supabase DEV, Clerk test, Stripe test, Resend, and Twilio credentials.
# SUPABASE_URL is derived from LOCAL_SUPABASE_PROJECT_REF by root local commands.
# Add the DEV server-side key to root .env:
# SUPABASE_SERVICE_ROLE_KEY="sb_secret_..."

# ── Notification isolation (required when LANDYS_ENV=local) ──
LOCAL_NOTIFICATION_EMAIL="qa@localhost.test"
LOCAL_NOTIFICATION_PHONE="+15005550006"

# ── Integrations (mocks by default) ──────────────────────────
STRIPE_MOCK="true"
# For real Stripe TEST checkout locally:
# STRIPE_MOCK="false"
# STRIPE_SECRET_KEY="sk_test_..."
# STRIPE_WEBHOOK_SECRET="whsec_..."   # from `stripe listen`

TWILIO_MOCK="true"
RESEND_MOCK="true"

WIX_ESTIMATE_INTEGRATION_ENABLED="true"
WIX_ESTIMATE_API_SECRET="local-wix-secret-change-me"
CRON_SECRET="local-cron-secret-change-me"

# Optional media (logos) — leave unset for local if unused
# SUPABASE_URL=
# SUPABASE_SERVICE_ROLE_KEY=
