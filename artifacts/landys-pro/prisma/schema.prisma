// Landy's Pro — Prisma schema (PostgreSQL / Supabase)
// Money is ALWAYS integer cents. No floats anywhere in storage.

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL") // pooled, runtime
  directUrl = env("DIRECT_URL") // direct, migrations
}

// ─────────────────────────────────────────────────────────────
// Reference / taxonomy
//
// Intended hierarchy (exactly two levels for pricing):
//   Project (ContractorType, 1:1 with a ProjectType of the same name)
//     └─ Tier 1 / 2 / 3 (PriceTier rows — lead price by job scale)
// There must not be multiple ProjectTypes nested under a ContractorType in
// normal operation; Settings + Pricing UIs treat ContractorType as "Project".
// ─────────────────────────────────────────────────────────────

model ContractorType {
  id        String   @id @default(cuid())
  name      String   @unique
  // Admin-selected 3D icon. Convention:
  //   null / "auto" → resolve by keyword from the project name
  //   "none"        → intentionally no icon (neutral fallback glyph)
  //   otherwise     → an icon key = base filename in /public/icons (e.g. "pond")
  icon      String?
  createdAt DateTime @default(now())

  contractors         Contractor[]
  assignedContractors ContractorProject[] @relation("ContractorAssignedProjects")
  projectType         ProjectType?
  priceTiers          PriceTier[]
}

model ProjectType {
  id               String   @id @default(cuid())
  name             String
  /// Immutable integration identifier. Display names may be edited.
  code             String   @unique
  contractorTypeId String   @unique
  createdAt        DateTime @default(now())
  archivedAt       DateTime?

  contractorType ContractorType @relation(fields: [contractorTypeId], references: [id], onDelete: Cascade)
  priceTiers     PriceTier[]
  leads          Lead[]

  @@unique([name, contractorTypeId])
  @@index([archivedAt])
}

model LandType {
  id         String    @id @default(cuid())
  name       String    @unique
  /// Immutable integration identifier. Display names may be edited.
  code       String    @unique
  archivedAt DateTime?
  leads      Lead[]

  @@index([archivedAt])
}

/// Business directory category. This is intentionally separate from the
/// legacy ContractorType project-routing compatibility entity.
model ContractorCategory {
  id         String    @id @default(cuid())
  name       String    @unique
  code       String    @unique
  archivedAt DateTime?
  createdAt  DateTime  @default(now())
  updatedAt  DateTime  @updatedAt

  contractors Contractor[]
  leads       Lead[]
  memberships ContractorCategoryMembership[]

  @@index([archivedAt])
}

model ContractorCategoryMembership {
  id           String   @id @default(cuid())
  contractorId String
  categoryId   String
  isPrimary    Boolean  @default(false)
  displayOrder Int      @default(0)
  createdAt    DateTime @default(now())

  contractor Contractor         @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  category   ContractorCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)

  @@unique([contractorId, categoryId])
  @@index([contractorId])
  @@index([categoryId])
}

// ─────────────────────────────────────────────────────────────
// Contractors
// ─────────────────────────────────────────────────────────────

model Contractor {
  id                           String    @id @default(cuid())
  name                         String
  email                        String    @unique
  phone                        String
  aboutSection                 String?
  businessHours                String?
  // Explicit primary project used for display. Eligibility uses `projects`;
  // assignment is multi-project and admin-controlled.
  contractorTypeId             String?
  contractorCategoryId         String?
  isPro                        Boolean   @default(false)
  walletBalanceCents           Int       @default(0)
  stripeCustomerId             String?
  // Saved off-session payment method (card) captured from the first top-up's
  // PaymentIntent (setup_future_usage=off_session). Enables admin "charge saved
  // card" + contractor "1-click recharge". Nullable: null = no reusable card yet.
  stripeDefaultPaymentMethodId String?
  // Display fields for the saved card (from Stripe PaymentMethod.card).
  cardBrand                    String?
  cardLast4                    String?
  clerkUserId                  String?   @unique
  /**
   * Optional profile / company logo path (e.g. /uploads/contractors/…).
   */
  logoUrl                      String?
  // Soft-deactivate: blocks login + lead distribution while preserving money/lead history.
  deactivatedAt                DateTime?
  createdAt                    DateTime  @default(now())
  updatedAt                    DateTime  @updatedAt

  contractorType     ContractorType?     @relation(fields: [contractorTypeId], references: [id])
  contractorCategory ContractorCategory? @relation(fields: [contractorCategoryId], references: [id], onDelete: Restrict)
  categoryMemberships ContractorCategoryMembership[]
  projects           ContractorProject[]
  externalIdentities ExternalContractorIdentity[]
  leadMatches        LeadMatch[]
  walletTransactions WalletTransaction[]

  @@index([contractorTypeId])
  @@index([contractorCategoryId])
  @@index([deactivatedAt])
}

/// Provider-neutral mapping used by isolated contractor import adapters.
model ExternalContractorIdentity {
  id              String   @id @default(cuid())
  source          String
  externalId      String
  contractorId    String
  lastPayloadHash String?
  lastSyncedAt    DateTime?
  sourceUpdatedAt DateTime?
  /// Wix aliases (contractorId, proPortalId) and optional raw payload snapshot.
  sourceMetadata  Json?
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)

  @@unique([source, externalId])
  @@index([contractorId])
}

/**
 * Projects a contractor is eligible to receive leads for (admin-assigned).
 */
model ContractorProject {
  id               String @id @default(cuid())
  contractorId     String
  contractorTypeId String

  contractor     Contractor     @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  contractorType ContractorType @relation("ContractorAssignedProjects", fields: [contractorTypeId], references: [id], onDelete: Restrict)

  @@unique([contractorId, contractorTypeId])
  @@index([contractorId])
  @@index([contractorTypeId])
}

// ─────────────────────────────────────────────────────────────
// Leads + distribution
// ─────────────────────────────────────────────────────────────

enum LeadStatus {
  NEW
  DISTRIBUTED
  SOLD_OUT
  EXPIRED
  CLOSED
}

enum LeadReviewStatus {
  PENDING_REVIEW
  READY
  ROUTED
}

enum LeadRoutingMode {
  GENERAL
  DIRECT
}

enum LeadMatchStatus {
  PENDING
  ACCEPTED
  DECLINED
  EXPIRED
  SOLD_OUT
}

enum WalletTransactionType {
  TOPUP // real money in via the contractor's card (Stripe)
  LEAD_CHARGE // spend: accepting a lead
  REFUND // returns money the contractor actually paid (bad lead, etc.) — CREDITS the wallet (internal, no card movement)
  ADMIN_ADJUST // admin correction — DEDUCT only (never mints funds)
  PROMO_CREDIT // admin-granted promotional balance — spendable, NOT real money
  CARD_REFUND // real money sent BACK to the contractor's card (Stripe refund) — DEBITS the wallet (distinct from internal REFUND)
}

model Lead {
  id               String     @id @default(cuid())
  landownerName    String?
  firstName        String?
  lastName         String?
  landownerEmail   String
  landownerPhone   String?
  propertyLocation String
  propertyZip      String?
  description      String?
  budget           String?
  budgetCents      Int?
  timeline         DateTime?
  urgency          String?
  landTypeId       String?
  contractorCategoryId String?
  projectTypeId    String
  tier             Int? // 1 / 2 / 3 after budget resolution
  priceCents       Int? // snapshotted from PriceTier exactly once
  maxPurchases     Int      @default(3)
  acceptedCount    Int      @default(0)
  soldOutAt        DateTime?
  status           LeadStatus @default(NEW)
  reviewStatus     LeadReviewStatus @default(PENDING_REVIEW)
  tierReviewRequired Boolean @default(true)
  budgetReviewRequired Boolean @default(false)
  contractorReviewRequired Boolean @default(false)
  routingMode      LeadRoutingMode @default(GENERAL)
  directContractorSource String?
  directContractorExternalId String?
  source           String     @default("wix_form")
  externalRequestId String?
  payloadHash      String?
  createdAt        DateTime   @default(now())
  updatedAt        DateTime   @updatedAt
  routedAt         DateTime?
  expiresAt        DateTime?

  landType    LandType?   @relation(fields: [landTypeId], references: [id])
  contractorCategory ContractorCategory? @relation(fields: [contractorCategoryId], references: [id], onDelete: Restrict)
  projectType ProjectType @relation(fields: [projectTypeId], references: [id])
  matches     LeadMatch[]
  attachments LeadAttachment[]

  @@index([status])
  @@index([projectTypeId])
  @@index([contractorCategoryId])
  @@index([reviewStatus])
  @@unique([source, externalRequestId])
}

/// Private-object metadata only. No Wix or public upload transport is enabled.
/// Future ingestion must create the private object before registering this row.
model LeadAttachment {
  id               String   @id @default(cuid())
  leadId           String
  storageProvider  String
  storageKey       String
  originalFilename String
  contentType      String
  sizeBytes        Int
  checksumSha256   String?
  ingestionError   String?
  sourceUrl        String?
  createdAt        DateTime @default(now())

  lead Lead @relation(fields: [leadId], references: [id], onDelete: Restrict)

  @@unique([storageProvider, storageKey])
  @@index([leadId])
}

// This join row lets multiple contractors independently accept the SAME lead;
// each tracks its own state and its own wallet charge.
model LeadMatch {
  id           String          @id @default(cuid())
  leadId       String
  contractorId String
  status       LeadMatchStatus @default(PENDING)
  acceptToken  String          @unique @default(cuid()) // tokenized SMS link
  acceptedAt   DateTime?
  createdAt    DateTime        @default(now())

  lead               Lead                @relation(fields: [leadId], references: [id], onDelete: Cascade)
  contractor         Contractor          @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  walletTransactions WalletTransaction[]

  @@unique([leadId, contractorId])
  @@index([contractorId])
  @@index([leadId])
}

// ─────────────────────────────────────────────────────────────
// Money
// ─────────────────────────────────────────────────────────────

model WalletTransaction {
  id                    String                @id @default(cuid())
  contractorId          String
  amountCents           Int // signed: +topup/refund/adjust, -charge
  type                  WalletTransactionType
  leadMatchId           String?
  stripePaymentIntentId String?               @unique
  note                  String?
  createdAt             DateTime              @default(now())

  contractor Contractor @relation(fields: [contractorId], references: [id], onDelete: Cascade)
  leadMatch  LeadMatch? @relation(fields: [leadMatchId], references: [id])

  // At most one LEAD_CHARGE / REFUND per match (blocks concurrent double-refund).
  @@unique([leadMatchId, type])
  @@index([contractorId])
  @@index([leadMatchId])
}

model PriceTier {
  id               String   @id @default(cuid())
  contractorTypeId String
  projectTypeId    String
  tier             Int // 1 / 2 / 3
  priceCents       Int
  /// Upper inclusive project budget bound for tiers 1 and 2. Tier 3 has no max.
  maxBudgetCents   Int?
  createdAt        DateTime @default(now())
  updatedAt        DateTime @updatedAt

  contractorType ContractorType @relation(fields: [contractorTypeId], references: [id], onDelete: Cascade)
  projectType    ProjectType    @relation(fields: [projectTypeId], references: [id], onDelete: Cascade)

  @@unique([contractorTypeId, projectTypeId, tier])
  @@index([contractorTypeId])
  @@index([projectTypeId])
}

// ─────────────────────────────────────────────────────────────
// Team / administration
// ─────────────────────────────────────────────────────────────

enum AdminRole {
  OWNER // can invite / remove / change roles of other admins
  ADMIN // full dashboard access; cannot manage team
}

enum InviteStatus {
  PENDING
  ACCEPTED
  EXPIRED
  REVOKED
}

/// Persistent admin user records. Bootstrapped for ADMIN_EMAILS users on
/// first login (as OWNER); all subsequent admins arrive via AdminInvite.
model AdminUser {
  id          String    @id @default(cuid())
  email       String    @unique
  name        String
  role        AdminRole @default(ADMIN)
  clerkUserId String?   @unique
  invitedById String?   // null = bootstrapped from ADMIN_EMAILS
  lastLoginAt DateTime?
  disabledAt  DateTime?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  invitedBy     AdminUser?    @relation("InvitedBy", fields: [invitedById], references: [id])
  invitedAdmins AdminUser[]   @relation("InvitedBy")
  sentInvites   AdminInvite[] @relation("SentBy")

  @@index([email])
  @@index([clerkUserId])
}

/// Pending/historical invitation tokens.
model AdminInvite {
  id          String       @id @default(cuid())
  email       String
  name        String
  role        AdminRole    @default(ADMIN)
  token       String       @unique @default(cuid())
  status      InviteStatus @default(PENDING)
  invitedById String?
  expiresAt   DateTime
  acceptedAt  DateTime?
  createdAt   DateTime     @default(now())

  invitedBy AdminUser? @relation("SentBy", fields: [invitedById], references: [id])

  @@index([email])
  @@index([token])
  @@index([status])
}

// ─────────────────────────────────────────────────────────────
// Config + audit
// ─────────────────────────────────────────────────────────────

model AppSetting {
  key       String   @id
  value     String
  updatedAt DateTime @updatedAt
}

model AuditLog {
  id         String   @id @default(cuid())
  actorType  String // 'admin' | 'contractor' | 'system'
  actorId    String?
  action     String
  targetType String?
  targetId   String?
  metadata   Json?
  createdAt  DateTime @default(now())

  @@index([targetType, targetId])
  @@index([action])
}

/// Idempotency ledger for Stripe webhooks. The primary key IS the Stripe event
/// id (evt_...); inserting it inside the same transaction as the wallet credit
/// means a duplicate webhook delivery fails the insert and the credit is skipped
/// — money can never be credited twice for the same event.
model ProcessedStripeEvent {
  id          String   @id // Stripe event id
  type        String
  processedAt DateTime @default(now())
}
